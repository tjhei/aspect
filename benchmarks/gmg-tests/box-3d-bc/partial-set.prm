# Nsinker benchmark using geometric multigrid preconditioner
# with global coarsening GMG
#
# MPI: 2

set Dimension = 3

include noslip.prm


subsection Boundary velocity model
# free slip: left, front
  set Zero velocity boundary indicators = right,bottom,back
  set Prescribed velocity boundary indicators = top x: function

  subsection Function
    set Function expression = sin(pi*x); 0; 0
  end
end
