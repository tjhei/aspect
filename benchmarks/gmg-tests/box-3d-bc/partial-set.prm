# Nsinker benchmark using geometric multigrid preconditioner
# with global coarsening GMG
#
# MPI: 2

set Dimension = 3

include base.prm


subsection Boundary velocity model
# free slip: left
  set Zero velocity boundary indicators = right,top,bottom,back
  set Tangential velocity boundary indicators = left,front
  set Prescribed velocity boundary indicators = front x: function

  subsection Function
    set Function expression = sin(pi*x)*z*(1-z); 0; 0
  end
end
